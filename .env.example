# SmartReply AI Environment Variables Example

# PostgreSQL Database
POSTGRES_DB=smartreply_db
POSTGRES_USER=smartreply
POSTGRES_PASSWORD=smartreply_secret
POSTGRES_PORT=5432

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartreply_db
SPRING_DATASOURCE_USERNAME=smartreply
SPRING_DATASOURCE_PASSWORD=smartreply_secret

# Security & Tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# WhatsApp Cloud API (Production credentials or Sandbox mode)
WHATSAPP_VERIFY_TOKEN=smartreply_verify_token_secure_2026
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# AI Provider (MOCK, OPENAI, ANTHROPIC)
AI_PROVIDER=MOCK
OPENAI_API_KEY=

# Public backend URL for Telegram/WhatsApp webhooks (production HTTPS, no trailing slash)
# Example: https://smartreply-backend-lyda.onrender.com
APP_BACKEND_BASE_URL=
BACKEND_BASE_URL=

# Google Gemini — used by WhatsApp/Telegram replies and the sidebar AI Assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
